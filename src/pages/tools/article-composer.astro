---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleComposer from '../../components/tools/composer/ArticleComposer';
import ToolHelpBox from '../../components/tools/ToolHelpBox.astro';
---

<BaseLayout
  title="記事コンポーザー"
  description="NLHのハンドをアクションで入力し、ストリートごとのテーブル図・アクションライン・本文から記事MDXを組み立てるツール。"
>
  <div class="max-w-7xl mx-auto px-4 py-10">
    <header class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-extrabold mb-2" style="color: var(--color-text);">記事コンポーザー</h1>
      <p class="text-base" style="color: var(--color-text-muted);">
        ①ハンド設定(ゲーム・人数・スタック・Hero/Villain)を入れる → ②各ストリートでアクションをボタンで入力しながら本文を書く → ③記事情報を入れてMDXをダウンロード、の順で1本の記事が完成します。ポット・スタック・テーブル図・アクションラインはアクションから自動で作られます。入力内容はこのブラウザに自動保存されます。
      </p>
    </header>

    <ToolHelpBox showRangeHelp />

    <ArticleComposer client:only="react" />
  </div>
</BaseLayout>
