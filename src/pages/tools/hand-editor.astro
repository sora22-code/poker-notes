---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HandEditor from '../../components/tools/HandEditor';
import ToolHelpBox from '../../components/tools/ToolHelpBox.astro';
---

<BaseLayout
  title="ハンド図エディタ"
  description="ポジション・スタック・ベット額・ボードを入力すると、記事に貼り付けられるPokerTableのMDXコードをその場で生成できるツール。"
>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <header class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-extrabold mb-2" style="color: var(--color-text);">ハンド図エディタ</h1>
      <p class="text-base" style="color: var(--color-text-muted);">
        ポジション・スタック・ベット額・ボードを入力すると、右側にテーブル図がリアルタイムで表示されます。「MDXをコピー」で記事にそのまま貼り付けられるコードが得られます。
      </p>
    </header>

    <ToolHelpBox />

    <HandEditor client:load />
  </div>
</BaseLayout>
