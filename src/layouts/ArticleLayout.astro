---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/article/Toc.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  emoji: string;
  category: 'strategy' | 'review';
  tags: string[];
  publishedAt: Date;
  updatedAt?: Date;
  headings: Heading[];
  ogImage?: string;
}

const { title, description, emoji, category, tags, publishedAt, updatedAt, headings, ogImage } = Astro.props;

const CATEGORY_LABEL: Record<string, string> = {
  strategy: '戦略解説',
  review: 'ハンドレビュー',
};

const publishedLabel = publishedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedLabel = updatedAt?.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-1 xl:grid-cols-[1fr_240px] gap-10">
    <article class="min-w-0 max-w-[720px] mx-auto w-full">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-3">
          <span
            class="text-xs font-bold px-2.5 py-1 rounded-full"
            style={`background: color-mix(in srgb, ${category === 'strategy' ? 'var(--color-tag-strategy)' : 'var(--color-tag-review)'} 15%, transparent); color: ${category === 'strategy' ? 'var(--color-tag-strategy)' : 'var(--color-tag-review)'};`}
          >
            {CATEGORY_LABEL[category]}
          </span>
          <time class="text-xs" style="color: var(--color-text-muted);">{publishedLabel}</time>
          {updatedLabel && updatedLabel !== publishedLabel && (
            <span class="text-xs" style="color: var(--color-text-muted);">(更新: {updatedLabel})</span>
          )}
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold leading-snug mb-3 flex items-start gap-2" style="color: var(--color-text);">
          <span aria-hidden="true">{emoji}</span>
          <span>{title}</span>
        </h1>
        <p class="text-base" style="color: var(--color-text-muted);">{description}</p>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-4">
            {tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded" style="background: var(--color-surface-muted); color: var(--color-text-muted);">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose-article" style="color: var(--color-text);">
        <slot />
      </div>
    </article>

    <aside>
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>
