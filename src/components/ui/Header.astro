---
import ThemeToggle from './ThemeToggle';
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur"
  style="background: color-mix(in srgb, var(--color-bg) 85%, transparent); border-color: var(--color-border);"
>
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg whitespace-nowrap" style="color: var(--color-text);">
      <span aria-hidden="true">🃏</span>
      <span>poker-notes</span>
    </a>
    <nav class="flex items-center gap-3 sm:gap-4 text-sm font-medium whitespace-nowrap" style="color: var(--color-text-muted);">
      <a href="/" class="hover:opacity-80">トップ</a>
      <a href="/tools" class="hover:opacity-80">ツール</a>
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
