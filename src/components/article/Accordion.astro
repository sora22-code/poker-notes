---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="not-prose my-4 rounded-lg border" style="border-color: var(--color-border); background: var(--color-surface);">
  <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-sm" style="color: var(--color-text);">
    {title}
  </summary>
  <div class="px-4 pb-4 text-sm leading-relaxed" style="color: var(--color-text-muted);">
    <slot />
  </div>
</details>
